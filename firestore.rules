rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Store Settings: Public read (needed for the customer-facing shop), auth required to write
    match /store_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Products catalogue: Public read (needed for online shop), auth required to write
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Articles (Blog posts & News): Public read (for website blog hub), auth required to write
    match /articles/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. All other collections (sales, users, orders, expenses, etc.):
    // Allow read for any request (handles sandbox mode where no real Firebase Auth token exists).
    // Writes always require a real authenticated Firebase session.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
